# 1. Server-Side Gemini 4 Hydrogen SI Engine Key (Required for live /api/si/chat & /api/si-synthesis)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Application Base URL
APP_URL="http://localhost:3000"

# 3. Optional Firebase Client SDK Overrides (Defaults to firebase-applet-config.json if omitted)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=""
