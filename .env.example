# 1. Server-Side Gemini 4 Hydrogen SI Engine Key (Required for live /api/si/chat & /api/si-synthesis)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Optional Firebase Client SDK Overrides (Defaults to firebase-applet-config.json if omitted)
